---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const brokers = await getCollection('brokers');
  return brokers.map((broker) => ({
    params: { slug: broker.id },
    props: { broker },
  }));
}

const { broker } = Astro.props;

const allBrokers = await getCollection('brokers');
const relatedBrokers = allBrokers
  .filter(b => b.id !== broker.id)
  .filter(b => b.data.platforms?.some(p => broker.data.platforms?.includes(p)) || false)
  .sort((a, b) => b.data.rating - a.data.rating)
  .slice(0, 3);

const trustLevel = broker.data.scores?.regulationTrust >= 9 ? 'Excellent' :
                  broker.data.scores?.regulationTrust >= 7 ? 'Good' : 'Fair';
---

<Layout title={broker.data.name} description={`${broker.data.name} review - Rating: ${broker.data.rating}/5. ${broker.data.headquarters}.`}>
  <div class="bg-gray-50 min-h-screen">
    <div class="bg-white border-b">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
        <nav class="text-sm text-gray-500">
          <a href="/" class="hover:text-primary-600">Home</a>
          <span class="mx-2">/</span>
          <a href="/brokers" class="hover:text-primary-600">Brokers</a>
          <span class="mx-2">/</span>
          <span class="text-gray-900">{broker.data.name}</span>
        </nav>
      </div>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <div class="lg:col-span-2 space-y-6">
          <div class="bg-white rounded-xl shadow-sm p-6">
            <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-6">
              <div class="flex items-center gap-4">
                <div class="w-20 h-20 bg-gray-100 rounded-lg flex items-center justify-center">
                  <span class="text-2xl font-bold text-gray-400">{broker.data.name.charAt(0)}</span>
                </div>
                <div>
                  <div class="flex items-center gap-2">
                    <span class="text-xs bg-primary-100 text-primary-700 px-2 py-1 rounded">#{broker.data.rank}</span>
                    <span class="text-sm text-gray-500">Est. {broker.data.established}</span>
                  </div>
                  <h1 class="text-3xl font-bold text-gray-900 mt-1">{broker.data.name}</h1>
                  <p class="text-gray-600">{broker.data.headquarters}</p>
                </div>
              </div>
              <div class="text-center md:text-right">
                <div class="flex items-center md:justify-end gap-2 mb-2">
                  <div class="flex">
                    {[...Array(5)].map((_, i) => (
                      <svg class={`w-5 h-5 ${i < Math.floor(broker.data.rating) ? 'text-yellow-400' : 'text-gray-200'}`} fill="currentColor" viewBox="0 0 20 20">
                        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                      </svg>
                    ))}
                  </div>
                  <span class="text-2xl font-bold text-gray-900">{broker.data.rating.toFixed(1)}</span>
                </div>
                <p class="text-sm text-gray-500">{broker.data.userReviewsCount || 'No'} reviews</p>
              </div>
            </div>

            {broker.data.scores && (
              <div class="mt-6 pt-6 border-t">
                <h3 class="font-semibold text-gray-900 mb-4">Rating Breakdown</h3>
                <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
                  {Object.entries(broker.data.scores).map(([key, value]) => (
                    <div>
                      <div class="flex justify-between text-sm mb-1">
                        <span class="text-gray-600 capitalize">{key.replace(/([A-Z])/g, ' $1').trim()}</span>
                        <span class="font-medium">{value}/10</span>
                      </div>
                      <div class="h-2 bg-gray-100 rounded-full overflow-hidden">
                        <div class="h-full bg-primary-500 rounded-full" style={`width: ${value * 10}%`}></div>
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            )}
          </div>

          <div class="bg-white rounded-xl shadow-sm p-6">
            <h2 class="text-xl font-bold text-gray-900 mb-4">About</h2>
            <p class="text-gray-600 leading-relaxed">{broker.data.description}</p>
          </div>

          <div class="grid md:grid-cols-2 gap-6">
            <div class="bg-white rounded-xl shadow-sm p-6">
              <h2 class="text-xl font-bold text-gray-900 mb-4 flex items-center gap-2">
                <svg class="w-5 h-5 text-green-500" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                </svg>
                Pros
              </h2>
              <ul class="space-y-3">
                {broker.data.pros?.slice(0, 6).map((pro) => (
                  <li class="flex items-start gap-2 text-gray-600">
                    <svg class="w-5 h-5 text-green-500 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                    </svg>
                    {pro}
                  </li>
                ))}
              </ul>
            </div>
            <div class="bg-white rounded-xl shadow-sm p-6">
              <h2 class="text-xl font-bold text-gray-900 mb-4 flex items-center gap-2">
                <svg class="w-5 h-5 text-red-500" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
                </svg>
                Cons
              </h2>
              <ul class="space-y-3">
                {broker.data.cons?.slice(0, 6).map((con) => (
                  <li class="flex items-start gap-2 text-gray-600">
                    <svg class="w-5 h-5 text-red-500 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
                    </svg>
                    {con}
                  </li>
                ))}
              </ul>
            </div>
          </div>

          <div class="bg-white rounded-xl shadow-sm p-6">
            <h2 class="text-xl font-bold text-gray-900 mb-4">Trading Platforms</h2>
            <div class="flex flex-wrap gap-3">
              {broker.data.platforms?.map((platform) => (
                <span class="px-4 py-2 bg-gray-100 text-gray-700 rounded-lg">{platform}</span>
              ))}
            </div>
          </div>

          {broker.data.spreads && broker.data.spreads.length > 0 && (
            <div class="bg-white rounded-xl shadow-sm p-6">
              <h2 class="text-xl font-bold text-gray-900 mb-4">Typical Spreads</h2>
              <div class="overflow-x-auto">
                <table class="w-full">
                  <thead>
                    <tr class="border-b">
                      <th class="text-left py-3 px-4 text-gray-600 font-medium">Currency Pair</th>
                      <th class="text-left py-3 px-4 text-gray-600 font-medium">Account Type</th>
                      <th class="text-right py-3 px-4 text-gray-600 font-medium">Spread From</th>
                      <th class="text-right py-3 px-4 text-gray-600 font-medium">Average</th>
                    </tr>
                  </thead>
                  <tbody>
                    {broker.data.spreads.map((spread) => (
                      <tr class="border-b last:border-0">
                        <td class="py-3 px-4 font-medium">{spread.currencyPair}</td>
                        <td class="py-3 px-4">{spread.accountType}</td>
                        <td class="py-3 px-4 text-right">{spread.spreadFrom} pips</td>
                        <td class="py-3 px-4 text-right">{spread.spreadAvg} pips</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </div>
          )}
        </div>

        <div class="space-y-6">
          <div class="bg-white rounded-xl shadow-sm p-6 text-center">
            <a href={broker.data.websiteUrl} target="_blank" rel="noopener noreferrer" class="block w-full bg-primary-600 text-white py-3 rounded-lg font-semibold hover:bg-primary-700 transition mb-4">
              Visit {broker.data.name}
            </a>
            <p class="text-sm text-gray-500">CFDs are complex instruments. 76% of retail investor accounts lose money.</p>
          </div>

          <div class="bg-white rounded-xl shadow-sm p-6">
            <h3 class="font-bold text-gray-900 mb-4">Regulation & Security</h3>
            {broker.data.regulations && broker.data.regulations.length > 0 ? (
              <ul class="space-y-3">
                {broker.data.regulations.map((reg) => (
                  <li class="flex items-start gap-3">
                    <svg class="w-5 h-5 text-green-500 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M2.166 4.999A11.954 11.954 0 0010 1.944 11.954 11.954 0 0017.834 5c.11.65.166 1.32.166 2.001 0 5.225-3.34 9.67-8 11.317C5.34 12.67 2 8.225 2 3c0-.66.055-1.306.166-2.001z" clip-rule="evenodd" />
                    </svg>
                    <div>
                      <p class="font-medium text-gray-900">{reg.name}</p>
                      <p class="text-sm text-gray-500">{reg.jurisdiction}</p>
                      {reg.licenseNumber && <p class="text-xs text-gray-400">License: {reg.licenseNumber}</p>}
                    </div>
                  </li>
                ))}
              </ul>
            ) : (
              <p class="text-gray-500 text-sm">No regulation data available</p>
            )}
            <div class="mt-4 pt-4 border-t">
              <div class="flex items-center justify-between">
                <span class="text-gray-600">Trust Score</span>
                <span class={`px-3 py-1 rounded-full text-sm font-medium ${trustLevel === 'Excellent' ? 'bg-green-100 text-green-700' : trustLevel === 'Good' ? 'bg-yellow-100 text-yellow-700' : 'bg-gray-100 text-gray-700'}`}>
                  {trustLevel}
                </span>
              </div>
            </div>
          </div>

          <div class="bg-white rounded-xl shadow-sm p-6">
            <h3 class="font-bold text-gray-900 mb-4">Quick Info</h3>
            <dl class="space-y-3">
              <div class="flex justify-between">
                <dt class="text-gray-600">Established</dt>
                <dd class="font-medium">{broker.data.established}</dd>
              </div>
              <div class="flex justify-between">
                <dt class="text-gray-600">Headquarters</dt>
                <dd class="font-medium text-right">{broker.data.headquarters}</dd>
              </div>
              <div class="flex justify-between">
                <dt class="text-gray-600">Rating</dt>
                <dd class="font-medium">{broker.data.rating.toFixed(1)}/5</dd>
              </div>
            </dl>
          </div>

          {relatedBrokers.length > 0 && (
            <div class="bg-white rounded-xl shadow-sm p-6">
              <h3 class="font-bold text-gray-900 mb-4">Similar Brokers</h3>
              <div class="space-y-4">
                {relatedBrokers.map((related) => (
                  <a href={`/brokers/${related.id}`} class="flex items-center gap-3 group">
                    <div class="w-10 h-10 bg-gray-100 rounded-lg flex items-center justify-center">
                      <span class="text-sm font-bold text-gray-400">{related.data.name.charAt(0)}</span>
                    </div>
                    <div class="flex-1">
                      <p class="font-medium text-gray-900 group-hover:text-primary-600">{related.data.name}</p>
                      <p class="text-sm text-gray-500">{related.data.headquarters}</p>
                    </div>
                    <div class="flex items-center">
                      <svg class="w-4 h-4 text-yellow-500" fill="currentColor" viewBox="0 0 20 20">
                        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                      </svg>
                      <span class="ml-1 text-sm font-medium">{related.data.rating.toFixed(1)}</span>
                    </div>
                  </a>
                ))}
              </div>
            </div>
          )}
        </div>
      </div>
    </div>
  </div>
</Layout>
