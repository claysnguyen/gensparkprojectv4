---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const brokers = await getCollection('brokers');
const sortedBrokers = brokers.sort((a, b) => b.data.rating - a.data.rating);

// Get unique platforms and headquarters for filters
const allPlatforms = [...new Set(brokers.flatMap(b => b.data.platforms || []))].sort();
const allHeadquarters = [...new Set(brokers.map(b => b.data.headquarters))].sort();

// Get min/max ratings
const minRating = Math.min(...brokers.map(b => b.data.rating));
const maxRating = Math.max(...brokers.map(b => b.data.rating));
---

<Layout title="Browse Forex Brokers" description="Compare 74+ forex brokers with ratings, spreads, and regulations.">
  <div class="bg-gray-100 min-h-screen">
    <!-- Header -->
    <div class="bg-primary-600 text-white py-12">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <h1 class="text-4xl font-bold mb-4">Compare Forex Brokers</h1>
        <p class="text-primary-100 text-lg">Browse our complete database of {brokers.length}+ reviewed forex brokers</p>
      </div>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <div class="flex flex-col lg:flex-row gap-8">
        <!-- Filters Sidebar -->
        <aside class="lg:w-64 flex-shrink-0">
          <div class="bg-white rounded-xl shadow-sm p-6 sticky top-24">
            <h2 class="text-lg font-semibold mb-4">Filters</h2>

            <!-- Search -->
            <div class="mb-6">
              <label class="block text-sm font-medium text-gray-700 mb-2">Search</label>
              <input
                type="text"
                id="searchInput"
                placeholder="Search brokers..."
                class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500"
              />
            </div>

            <!-- Rating Filter -->
            <div class="mb-6">
              <label class="block text-sm font-medium text-gray-700 mb-2">Minimum Rating</label>
              <select id="ratingFilter" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500">
                <option value="0">Any Rating</option>
                <option value="4.5">4.5+ Stars</option>
                <option value="4">4+ Stars</option>
                <option value="3.5">3.5+ Stars</option>
                <option value="3">3+ Stars</option>
              </select>
            </div>

            <!-- Platform Filter -->
            <div class="mb-6">
              <label class="block text-sm font-medium text-gray-700 mb-2">Platform</label>
              <select id="platformFilter" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500">
                <option value="">All Platforms</option>
                {allPlatforms.slice(0, 10).map(platform => (
                  <option value={platform}>{platform}</option>
                ))}
              </select>
            </div>

            <!-- Country Filter -->
            <div class="mb-6">
              <label class="block text-sm font-medium text-gray-700 mb-2">Headquarters</label>
              <select id="countryFilter" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500">
                <option value="">All Countries</option>
                {allHeadquarters.slice(0, 15).map(hq => (
                  <option value={hq}>{hq}</option>
                ))}
              </select>
            </div>

            <button
              id="resetFilters"
              class="w-full bg-gray-100 text-gray-700 py-2 rounded-lg hover:bg-gray-200 transition"
            >
              Reset Filters
            </button>
          </div>
        </aside>

        <!-- Broker List -->
        <main class="flex-1">
          <div class="flex justify-between items-center mb-6">
            <p class="text-gray-600"><span id="brokerCount">{sortedBrokers.length}</span> brokers found</p>
            <select id="sortFilter" class="px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500">
              <option value="rating">Sort by Rating</option>
              <option value="name">Sort by Name</option>
              <option value="established">Sort by Established</option>
            </select>
          </div>

          <div id="brokerGrid" class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {sortedBrokers.map((broker) => (
              <article
                class="broker-card bg-white rounded-xl shadow-sm hover:shadow-md transition overflow-hidden"
                data-name={broker.data.name.toLowerCase()}
                data-rating={broker.data.rating}
                data-platforms={JSON.stringify(broker.data.platforms || [])}
                data-hq={broker.data.headquarters}
              >
                <div class="p-6">
                  <div class="flex items-start gap-4 mb-4">
                    {broker.data.logoUrl && (
                      <img src={broker.data.logoUrl} alt={broker.data.name} class="w-12 h-12 object-contain flex-shrink-0" />
                    )}
                    <div class="flex-1">
                      <span class="text-xs text-primary-600 font-medium">#{broker.data.rank}</span>
                      <h3 class="text-xl font-semibold text-gray-900 mt-1">
                        <a href={`/brokers/${broker.id}`} class="hover:text-primary-600">
                          {broker.data.name}
                        </a>
                      </h3>
                      <p class="text-sm text-gray-500">{broker.data.headquarters}</p>
                    </div>
                    <div class="text-right flex-shrink-0">
                      <div class="flex items-center bg-primary-100 text-primary-700 px-3 py-1 rounded-full">
                        <svg class="w-4 h-4 text-yellow-500 mr-1" fill="currentColor" viewBox="0 0 20 20">
                          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                        </svg>
                        <span class="font-semibold">{broker.data.rating.toFixed(1)}</span>
                      </div>
                      <p class="text-xs text-gray-500 mt-1">{broker.data.userReviewsCount || 0} reviews</p>
                    </div>
                  </div>

                  <p class="text-gray-600 text-sm mb-4 line-clamp-2">{broker.data.description}</p>

                  <div class="flex flex-wrap gap-2 mb-4">
                    {broker.data.platforms?.slice(0, 4).map((platform) => (
                      <span class="text-xs bg-gray-100 text-gray-600 px-2 py-1 rounded">{platform}</span>
                    ))}
                  </div>

                  <div class="flex items-center justify-between pt-4 border-t">
                    <div class="text-sm">
                      <span class="text-gray-500">Est. </span>
                      <span class="font-medium">{broker.data.established}</span>
                    </div>
                    <a href={`/brokers/${broker.id}`} class="text-primary-600 hover:text-primary-700 font-medium text-sm">
                      View Details →
                    </a>
                  </div>
                </div>
              </article>
            ))}
          </div>
        </main>
      </div>
    </div>
  </div>
</Layout>

<script>
  // Client-side filtering
  const brokerCards = document.querySelectorAll('.broker-card');
  const searchInput = document.getElementById('searchInput') as HTMLInputElement;
  const ratingFilter = document.getElementById('ratingFilter') as HTMLSelectElement;
  const platformFilter = document.getElementById('platformFilter') as HTMLSelectElement;
  const countryFilter = document.getElementById('countryFilter') as HTMLSelectElement;
  const sortFilter = document.getElementById('sortFilter') as HTMLSelectElement;
  const resetButton = document.getElementById('resetFilters');
  const brokerCount = document.getElementById('brokerCount');
  const brokerGrid = document.getElementById('brokerGrid');

  function filterBrokers() {
    const search = searchInput.value.toLowerCase();
    const minRating = parseFloat(ratingFilter.value);
    const platform = platformFilter.value;
    const country = countryFilter.value;

    let visibleCount = 0;
    const visibleCards: HTMLElement[] = [];

    brokerCards.forEach((card) => {
      const el = card as HTMLElement;
      const name = el.dataset.name || '';
      const rating = parseFloat(el.dataset.rating || '0');
      const platforms = JSON.parse(el.dataset.platforms || '[]');
      const hq = el.dataset.hq || '';

      const matchesSearch = name.includes(search);
      const matchesRating = rating >= minRating;
      const matchesPlatform = !platform || platforms.includes(platform);
      const matchesCountry = !country || hq === country;

      const isVisible = matchesSearch && matchesRating && matchesPlatform && matchesCountry;
      el.style.display = isVisible ? 'block' : 'none';

      if (isVisible) {
        visibleCount++;
        visibleCards.push(el);
      }
    });

    if (brokerCount) brokerCount.textContent = visibleCount.toString();

    // Sort visible cards
    const sort = sortFilter.value;
    visibleCards.sort((a, b) => {
      const brokerA = a;
      const brokerB = b;
      if (sort === 'rating') {
        return parseFloat(brokerB.dataset.rating || '0') - parseFloat(brokerA.dataset.rating || '0');
      } else if (sort === 'name') {
        return (brokerA.dataset.name || '').localeCompare(brokerB.dataset.name || '');
      } else if (sort === 'established') {
        const aEst = parseInt(brokerA.closest('article')?.querySelector('.text-sm font-medium')?.textContent || '0');
        return 0;
      }
      return 0;
    });

    if (brokerGrid) {
      visibleCards.forEach(card => brokerGrid.appendChild(card));
    }
  }

  searchInput?.addEventListener('input', filterBrokers);
  ratingFilter?.addEventListener('change', filterBrokers);
  platformFilter?.addEventListener('change', filterBrokers);
  countryFilter?.addEventListener('change', filterBrokers);
  sortFilter?.addEventListener('change', filterBrokers);

  resetButton?.addEventListener('click', () => {
    searchInput.value = '';
    ratingFilter.value = '0';
    platformFilter.value = '';
    countryFilter.value = '';
    filterBrokers();
  });
</script>
